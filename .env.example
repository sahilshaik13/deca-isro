# Copy to .env (gitignored) and fill in. Never commit real passwords.
#
# DevNet XRd sandbox (VPN):
#   Jump host: developer@10.10.20.15  password C1sco12345!
#   XR nodes:  cisco@10.10.20.101|102|103  password C1sco12345  (no trailing !)
#
# Scraper targets an XR node (not the Ubuntu jump host):
DECA_CISCO_HOST=10.10.20.101
DECA_CISCO_USER=cisco
DECA_CISCO_PASSWORD=
DECA_CISCO_DEVICE=cisco_xr
DECA_CISCO_INTERFACE=GigabitEthernet0/0/0/0
DECA_CISCO_DURATION_S=1800
DECA_CISCO_INTERVAL_S=15
