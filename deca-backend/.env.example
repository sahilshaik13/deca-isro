# Copy to .env and adjust for your environment:
#   cp .env.example .env

# --- Server ---
# Bind on all interfaces so remote clients can reach the API when deployed
DECA_HOST=0.0.0.0
DECA_PORT=8000
DECA_RELOAD=false

# URL other services use to call this API (set to your server IP/domain in production)
# Examples:
#   http://192.168.1.50:8000
#   https://deca-api.yourdomain.com
DECA_API_BASE_URL=http://localhost:8000

# Comma-separated frontend origins, or * for any
DECA_CORS_ORIGINS=*

# --- Paths ---
DECA_MODELS_DIR=./models
DECA_CHROMA_DIR=./chroma_store
DECA_RUNBOOKS_DIR=./runbooks
DECA_DATASET_PATH=../data/processed/deca_unified_dataset.parquet

# --- Models (GGUF filenames in DECA_MODELS_DIR) ---
DECA_EMBED_MODEL_FILE=all-MiniLM-L6-v2-Q4_K_M.gguf
# Leave empty until a smaller local LLM alternative is chosen
# DECA_LLM_MODEL_FILE=
# DECA_LLM_MODEL_REPO=

# --- ML / LLM ---
DECA_SEQ_LEN=40
DECA_LLM_N_CTX=2048
DECA_LLM_N_THREADS=6

# --- Demo streamer ---
DECA_STREAM_STEP_ROWS=5
DECA_STREAM_INTERVAL_SEC=3

# --- Live Prometheus / RPi stations ---
DECA_PROMETHEUS_URL=http://localhost:9090
DECA_PROMETHEUS_JOB=deca_edge_nodes
DECA_PROMETHEUS_JOBS=deca_edge_nodes,deca_core_router
DECA_THROUGHPUT_INTERFACE_REGEX=veth-pe-.*|vrf-mission
# Legacy single-NIC override (optional; regex above is preferred)
DECA_EDGE_INTERFACE=
DECA_RPI_STATIONS=station1,station2,station3
DECA_RPI_AUTO_DISCOVER=true
DECA_TELEMETRY_HISTORY_LEN=60
DECA_PROMETHEUS_RATE_WINDOW=1m
# Jitter/loss come from Telegraf inputs.ping (ICMP stddev + loss) and eth0 net_drop counters.
# Fault campaign applies tc netem/tbf on station1 eth0 — same path as LAN iperf.
