# Copy to .env.local for local dev:
#   cp .env.example .env.local

# Backend URL for Next.js server-side proxy (browser uses /api/deca/*).
# Prefer 127.0.0.1 over localhost (avoids IPv6 ::1 vs uvicorn on 127.0.0.1).
# Also used by the browser for terminal WebSockets (ws://127.0.0.1:8000/...).
DECA_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DECA_API_URL=http://127.0.0.1:8000

# Dashboard poll interval in milliseconds
NEXT_PUBLIC_DECA_POLL_MS=5000
